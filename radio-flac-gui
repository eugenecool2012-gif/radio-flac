        toolbar.add_bottom_bar(bar_box)
        self.toast = Adw.ToastOverlay()
        self.toast.set_child(toolbar)
        self.set_content(self.toast)

        for name, cb in (("open-folder", self._open_folder), ("about", self._about)):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", cb)
            self.add_action(action)
        self.connect("close-request", self._on_close_request)

        # ---------- каталог, фильтры, поиск ----------
    def _load_catalog(self):
        try:
            countries = rb_countries()
            tags = rb_tags()
        except Exception as e:  # noqa: BLE001
            GLib.idle_add(self.toast.add_toast,
                          Adw.Toast.new(f"Каталог недоступен: {e}"))
            return
        GLib.idle_add(self._fill_filters, countries, tags)

    def _fill_filters(self, countries, tags):
        self.country_codes = [""] + [code for _name, code in countries]
        self.country_filter.set_model(Gtk.StringList.new(
            ["Любая страна"] + [name for name, _code in countries]))
        self.tag_names = [""] + tags
        self.tag_filter.set_model(Gtk.StringList.new(["Любой жанр"] + tags))
        if self.cfg.get("country") in self.country_codes:
            self.country_filter.set_selected(self.country_codes.index(self.cfg["country"]))
        if self.cfg.get("tag") in self.tag_names:
            self.tag_filter.set_selected(self.tag_names.index(self.cfg["tag"]))
        return False

    def _search_changed(self, _entry):
        if self.search_source:
            GLib.source_remove(self.search_source)
        self.search_source = GLib.timeout_add(500, self._reload_browse)

    def _reload_browse(self):
        self.search_source = 0
        cidx = self.country_filter.get_selected()
        tidx = self.tag_filter.get_selected()
        cidx = 0 if cidx == Gtk.INVALID_LIST_POSITION else cidx
        tidx = 0 if tidx == Gtk.INVALID_LIST_POSITION else tidx
        code = self.country_codes[cidx] if cidx < len(self.country_codes) else ""
        tag = self.tag_names[tidx] if tidx < len(self.tag_names) else ""
        query = self.search.get_text().strip()
        if (code, tag) != (self.cfg.get("country"), self.cfg.get("tag")):
            self.cfg["country"], self.cfg["tag"] = code, tag
            save_config(self.cfg)
        if not self.station:
            self.now_title.set_text("загружаю станции…")
        threading.Thread(target=self._browse_worker,
                         args=(query, code, tag), daemon=True).start()
        return False

    def _browse_worker(self, query, code, tag):
        try:
            if query or code or tag:
                found = rb_stations(name=query, countrycode=code, tag=tag)
            else:
                found = rb_popular()
        except Exception as e:  # noqa: BLE001
            GLib.idle_add(self._browse_failed, str(e))
            return
        GLib.idle_add(self._fill_results, found)

    def _browse_failed(self, message):
        self.now_title.set_text("")
        self.toast.add_toast(Adw.Toast.new(f"Не удалось получить список: {message}"))
        return False

    def _fill_results(self, stations):
        while (row := self.results.get_first_child()) is not None:
            self.results.remove(row)
        for s in stations:
            self.results.append(make_row(s, self._play_station,
                                         on_favorite=self._toggle_favorite,
                                         favorite=self._is_favorite(s)))
        self.now_title.set_text(f"станций в списке: {len(stations)}"
                                if stations else "ничего не найдено")
        return False

        # ---------- выбор, воспроизведение, запись ----------
    def _result_selected(self, _list, row):
        if row is not None:
            self._select_station(row.station, remember=False)

    def _saved_selected(self, _list, row):
        if row is not None:
            self._select_station(row.station, remember=False)

    def _result_activated(self, _list, row):
        if row is not None:
            self._play_station(row.station)

    def _play_clicked(self, *_):
        if self.station is None:
            self.toast.add_toast(Adw.Toast.new("Сначала выберите станцию"))
            return
        if self.player.is_playing():
            self.player.toggle()
        else:
            self._play_station(self.station)

    def _play_station(self, station):
        self._select_station(station, remember=True)
        self.player.play(station)
        self.now_title.set_text("подключаюсь к потоку…")
        self._update_ui()

    def _select_station(self, station, remember=True):
        self.station = station
        self.current_title = ""
        self.cfg["last_url"] = station["url"]
        if remember:
            self._remember(station)
        save_config(self.cfg)
        self.now_title.set_text(codec_hint(station.get("codec", "")))
        self._update_ui()

    def _remember(self, station):
        rest = [s for s in self.cfg["stations"] if s["url"] != station["url"]]
        self.cfg["stations"] = ([{"name": station["name"], "url": station["url"],
                                  "codec": station.get("codec", "?"),
                                  "country": station.get("country", ""),
                                  "favicon": station.get("favicon", "")}] + rest)[:20]
        self._refresh_saved()

    def _refresh_saved(self):
        while (row := self.saved.get_first_child()) is not None:
            self.saved.remove(row)
        for s in self.cfg["stations"]:
            self.saved.append(make_row(s, self._play_station,
                                       on_favorite=self._toggle_favorite,
                                       favorite=True,
                                       on_delete=self._remove_station))

    # ---------- избранное ----------
    def _is_favorite(self, station):
        return any(s["url"] == station["url"] for s in self.cfg["stations"])

    def _toggle_favorite(self, station, want):
        if getattr(self, "_syncing", False):
            return
        if want:
            self._remember(station)
        else:
            self._remove_station(station)
        self._sync_hearts()

    def _remove_station(self, station):
        before = len(self.cfg["stations"])
        self.cfg["stations"] = [s for s in self.cfg["stations"]
                                if s["url"] != station["url"]]
        if len(self.cfg["stations"]) != before:
            save_config(self.cfg)
            # перестраиваем списки не внутри обработчика кнопки, иначе строка
            # уничтожается прямо посреди своего же сигнала
            GLib.idle_add(self._after_remove, station)

    def _after_remove(self, station):
        self._refresh_saved()
        self._sync_hearts()
        self.toast.add_toast(Adw.Toast.new(f"«{station['name'][:40]}» убрана из моих станций"))
        return False

    def _sync_hearts(self):
        """Приводит сердечки в списке «Обзор» в соответствие с избранным."""
        saved_urls = {s["url"] for s in self.cfg["stations"]}
        self._syncing = True
        try:
            row = self.results.get_first_child()
            while row is not None:
                heart = getattr(row, "heart", None)
                station = getattr(row, "station", None)
                if heart is not None and station is not None:
                    want = station["url"] in saved_urls
                    if heart.get_active() != want:
                        heart.set_active(want)
                row = row.get_next_sibling()
        finally:
            self._syncing = False

    def _on_player_state(self, state, detail):
        if state == "error":
            self.toast.add_toast(Adw.Toast.new(f"Поток не играет: {detail}"))
            self.now_title.set_text("ошибка воспроизведения")
        elif state == "playing":
            self.now_title.set_text("играет…")
        self._update_ui()
        return False

    def _on_player_title(self, title):
        self.current_title = title
        self.now_title.set_text(title)
        self._sync_shell()
        return False

    def _volume_changed(self, button, value):
        self.player.set_volume(value)
        self.cfg["volume"] = round(value, 2)
        save_config(self.cfg)
        mpris = getattr(self, "mpris", None)
        if mpris is not None:
            mpris.update(volume=round(value, 2))

    def _toggle_record(self, *_):
        if self.rec.running:
            self.rec.stop()
            self.files_label.set_text("останавливаю…")
            return
        if not self.station:
            self.toast.add_toast(Adw.Toast.new("Сначала выберите станцию"))
            return
        if self.rec.start(self.station["url"], self.station["name"],
                          self.cfg["directory"], int(self.cfg["min_duration"]),
                          int(self.cfg.get("split_every", 0)),
                          bool(self.cfg.get("full_tracks", True)),
                          self._lead_for(self.station)):
            self.files = 0
            self._append_log(f"— запись: {self.station['name']}")
        self._update_ui()

    def _on_line(self, line):
        self._append_log(line)
        if "готово:" in line:
            self.files += 1
        return False

    def _append_log(self, line):
        end = self.log_buffer.get_end_iter()
        prefix = "" if self.log_buffer.get_char_count() == 0 else "\n"
        self.log_buffer.insert(end, prefix + line)
        mark = self.log_buffer.create_mark(None, self.log_buffer.get_end_iter(), False)
        self.log_view.scroll_mark_onscreen(mark)

    def _on_exit(self, code):
        self._append_log(f"— запись остановлена (код {code})")
        self.files_label.set_text(f"готово файлов: {self.files}" if self.files else "")
        self._update_ui()
        return False

    def _tick(self):
        if self.rec.running:
            elapsed = int(time.time() - self.rec.started)
            self.files_label.set_text(
                f"⏺ {elapsed // 60:02d}:{elapsed % 60:02d} · файлов {self.files}")
        return True

    def _update_ui(self):
        playing = self.player.is_playing()
        self.play_button.set_icon_name("media-playback-pause-symbolic" if playing
                                       else "media-playback-start-symbolic")
        self.play_button.set_tooltip_text("Пауза" if playing else "Слушать")
        self.now_station.set_text(self.station["name"] if self.station else "Станция не выбрана")
        recording = self.rec.running
        self.record_button.set_icon_name("media-playback-stop-symbolic" if recording
                                         else "media-record-symbolic")
        self.record_button.set_tooltip_text("Остановить запись" if recording
                                            else "Записать в FLAC")
        self.record_button.remove_css_class("destructive-action")
        if recording:
            self.record_button.add_css_class("destructive-action")
        self.folder_button.set_label(f"Папка записей: {self.cfg['directory']}")
        self.cast_button.set_icon_name("video-display-symbolic")
        self.cast_button.set_tooltip_text("Остановить трансляцию" if self.cast.active
                                          else "Транслировать на Chromecast")
        self._show_lead()
        self._sync_shell()

    def _split_changed(self, spin):
        self.cfg["split_every"] = int(spin.get_value())
        save_config(self.cfg)

    def _full_tracks_changed(self, switch, _param):
        self.cfg["full_tracks"] = bool(switch.get_active())
        save_config(self.cfg)

    def _lead_changed(self, spin):
        if getattr(self, "_syncing_lead", False):
            return
        value = float(spin.get_value())
        self.cfg["lead"] = value
        if self.station:
            lead_map = self.cfg.setdefault("lead_map", {})
            if value:
                lead_map[self.station["url"]] = value
            else:
                lead_map.pop(self.station["url"], None)
        save_config(self.cfg)

    def _lead_for(self, station):
        if not station:
            return float(self.cfg.get("lead", 0))
        return float(self.cfg.get("lead_map", {}).get(station["url"], self.cfg.get("lead", 0)))

    def _show_lead(self):
        """Показывает в поле сдвиг, сохранённый для выбранной станции."""
        if not hasattr(self, "lead_spin"):
            return
        value = self._lead_for(self.station)
        if abs(self.lead_spin.get_value() - value) > 0.01:
            self._syncing_lead = True
            self.lead_spin.set_value(value)
            self._syncing_lead = False

    def _choose_folder(self, *_):
        dialog = Gtk.FileDialog(title="Куда складывать записи")
        dialog.set_initial_folder(Gio.File.new_for_path(self.cfg["directory"]))
        dialog.select_folder(self, None, self._folder_chosen)

    def _folder_chosen(self, dialog, result):
        try:
            folder = dialog.select_folder_finish(result)
        except GLib.Error:
            return
        if folder:
            self.cfg["directory"] = folder.get_path()
            save_config(self.cfg)
            self._update_ui()

    def _open_folder(self, *_):
        os.makedirs(self.cfg["directory"], exist_ok=True)
        Gio.AppInfo.launch_default_for_uri(
            Gio.File.new_for_path(self.cfg["directory"]).get_uri(), None)

    def _about(self, *_):
        Adw.AboutDialog(
            application_name="Radio FLAC",
            application_icon=APP_ID,
            version="1.1",
            developer_name="локальная сборка",
            comments="Слушание интернет-радио и запись в отдельные FLAC-файлы.\n"
                     "Каталог станций — radio-browser.info, запись — radio-flac.",
        ).present(self)

    def _on_close_request(self, *_):
        if self.rec.running:
            dialog = Adw.AlertDialog(
                heading="Идёт запись",
                body="Остановить запись и закрыть окно? Текущий трек будет дописан.")
            dialog.add_response("cancel", "Отмена")
            dialog.add_response("stop", "Остановить и выйти")
            dialog.set_response_appearance("stop", Adw.ResponseAppearance.DESTRUCTIVE)
            dialog.connect("response", self._close_confirmed)
            dialog.present(self)
            return True
        self._shutdown_shell()
        self.player.stop()
        return False

    def _close_confirmed(self, _dialog, response):
        if response != "stop":
            return
        self.rec.stop()
        self._shutdown_shell()
        self.player.stop()
        self.destroy()

    def _shutdown_shell(self):
        for attr in ("tray", "mpris"):
            obj = getattr(self, attr, None)
            if obj is not None:
                try:
                    obj.unregister()
                except Exception:  # noqa: BLE001
                    pass
                setattr(self, attr, None)

    # ---------- эквалайзер ----------
    def _build_eq_popover(self):
        popover = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                      margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        top.append(Gtk.Label(label="Эквалайзер", xalign=0, hexpand=True,
                             css_classes=["heading"]))
        self.eq_switch = Gtk.Switch(active=bool(self.cfg.get("eq_enabled")),
                                    valign=Gtk.Align.CENTER)
        self.eq_switch.connect("notify::active", self._eq_switch_changed)
        top.append(self.eq_switch)
        box.append(top)

        preset_names = list(EQ_PRESETS)
        preset = self.cfg.get("eq_preset", "Плоско")
        self.eq_preset = Gtk.DropDown(model=Gtk.StringList.new(preset_names),
                                      selected=preset_names.index(preset) if preset in preset_names else 0)
        self.eq_preset.connect("notify::selected", self._eq_preset_changed)
        box.append(self.eq_preset)

        scales = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        self.eq_scales = []
        self._eq_updating = False
        for index, band in enumerate(EQ_BANDS):
            column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            adjustment = Gtk.Adjustment(value=float(self.eq.gains[index]),
                                        lower=-12.0, upper=12.0,
                                        step_increment=1.0, page_increment=3.0)
            scale = Gtk.Scale(orientation=Gtk.Orientation.VERTICAL, inverted=True,
                              draw_value=False, adjustment=adjustment, height_request=130)
            scale.connect("value-changed", self._eq_band_changed, index)
            self.eq_scales.append(scale)
            label = Gtk.Label(label=(f"{band // 1000}k" if band >= 1000 else str(band)),
                              css_classes=["caption", "dim-label"])
            column.append(scale)
            column.append(label)
            scales.append(column)
        box.append(scales)

        reset = Gtk.Button(label="Сбросить", css_classes=["pill"])
        reset.connect("clicked", lambda *_: self._eq_apply_preset("Плоско"))
        box.append(reset)
        popover.set_child(box)
        self._eq_set_sensitive(bool(self.cfg.get("eq_enabled")))
        return popover

    def _eq_set_sensitive(self, enabled):
        for scale in getattr(self, "eq_scales", []):
            scale.set_sensitive(enabled)

    def _eq_switch_changed(self, switch, _param):
        enabled = switch.get_active()
        self.eq.apply(enabled=enabled)
        self.cfg["eq_enabled"] = enabled
        save_config(self.cfg)
        self._eq_set_sensitive(enabled)

    def _eq_band_changed(self, scale, index):
        if self._eq_updating:
            return
        self.eq.set_band(index, scale.get_value())
        self.cfg["eq_gains"] = list(self.eq.gains)
        save_config(self.cfg)

    def _eq_preset_changed(self, dropdown, _param):
        names = list(EQ_PRESETS)
        index = dropdown.get_selected()
        if index == Gtk.INVALID_LIST_POSITION or index >= len(names):
            return
        self._eq_apply_preset(names[index])

    def _eq_apply_preset(self, name):
        gains = EQ_PRESETS.get(name, [0] * 10)
        self._eq_updating = True
        for scale, gain in zip(self.eq_scales, gains):
            scale.set_value(float(gain))
        self._eq_updating = False
        self.eq.apply(gains=gains)
        self.cfg["eq_gains"] = list(gains)
        self.cfg["eq_preset"] = name
        save_config(self.cfg)
        names = list(EQ_PRESETS)
        if name in names:
            self.eq_preset.set_selected(names.index(name))

    # ---------- Chromecast ----------
    def _open_cast(self, *_):
        if self.cast.active:
            self.cast.stop()
            self.toast.add_toast(Adw.Toast.new("Трансляция остановлена"))
            self._update_ui()
            return
        if not self.station:
            self.toast.add_toast(Adw.Toast.new("Сначала выберите станцию"))
            return
        if not rf_cast.available():
            self.toast.add_toast(Adw.Toast.new("Модуль pychromecast не установлен"))
            return
        rf_cast.CastDialog(self.station, self._do_cast).present(self)

    def _do_cast(self, station, device_name):
        def worker():
            try:
                name = self.cast.play(station, device_name)
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(self.toast.add_toast,
                              Adw.Toast.new(f"Не удалось транслировать: {e}"))
                return
            GLib.idle_add(self._cast_done, name)

        self.toast.add_toast(Adw.Toast.new(f"Подключаюсь к «{device_name}»…"))
        threading.Thread(target=worker, daemon=True).start()

    def _cast_done(self, name):
        self.toast.add_toast(Adw.Toast.new(f"Трансляция: {name}"))
        self._update_ui()
        return False

    # ---------- лоток и MPRIS ----------
    def _init_shell(self):
        self.tray = None
        self.mpris = None
        callbacks = {
            "show": self._show_window,
            "play_pause": self._play_clicked,
            "record": self._toggle_record,
            "quit": self._quit,
            "play": self._shell_play,
            "pause": self._shell_pause,
            "stop": self._shell_stop,
            "raise_window": self._show_window,
            "set_volume": self.volume.set_value,
        }
        try:
            if rf_tray.available():
                self.tray = rf_tray.TrayIcon(callbacks)
        except Exception as e:  # noqa: BLE001
            print("лоток недоступен:", e, file=sys.stderr)
        try:
            self.mpris = rf_mpris.Mpris(callbacks)
        except Exception as e:  # noqa: BLE001
            print("MPRIS недоступен:", e, file=sys.stderr)
        self._sync_shell()

    def _sync_shell(self):
        playing = self.player.is_playing()
        paused = self.player.playbin.get_state(0)[1] == Gst.State.PAUSED
        if self.rec.running:
            state = "recording"
        elif playing:
            state = "playing"
        else:
            state = "stopped"
        tray = getattr(self, "tray", None)
        mpris = getattr(self, "mpris", None)
        if tray is not None:
            tray.set_state(state)
        if mpris is not None:
            mpris.update(
                status="Playing" if playing else ("Paused" if paused else "Stopped"),
                station=self.station["name"] if self.station else "",
                title=self.current_title or (self.station["name"] if self.station else ""),
            )
    def _shell_play(self):
        if self.station:
            self._play_station(self.station)
        return False

    def _shell_pause(self):
        if self.player.is_playing():
            self.player.toggle()
        return False

    def _shell_stop(self):
        self.player.stop()
        self._update_ui()
        return False

    def _show_window(self):
        self.present()
        return False

    def _quit(self):
        self.close()
        return False

    def _snapshot(self, path):
        """Сохраняет вид окна в PNG, без съёмки всего рабочего стола."""
        width, height = self.get_width(), self.get_height()
        paintable = Gtk.WidgetPaintable.new(self)
        snap = Gtk.Snapshot()
        paintable.snapshot(snap, width, height)
        node = snap.to_node()
        texture = self.get_native().get_renderer().render_texture(node, None)
        texture.save_to_png(path)
        return width, height


def selftest():
    """Проверка без человека: строит окно, печатает дерево, снимает PNG."""
    app = Adw.Application(application_id=APP_ID + ".Test")

    def on_activate(a):
        win = Window(a)
        lines = []

        def walk(w, depth=0):
            extra = ""
            if isinstance(w, Gtk.Label):
                extra = f"  label={w.get_text()[:55]!r}"
            elif isinstance(w, Gtk.Button):
                extra = f"  button={w.get_label() or w.get_icon_name()!r}"
            elif isinstance(w, Gtk.SearchEntry):
                extra = f"  placeholder={w.get_placeholder_text()!r}"
            elif isinstance(w, Gtk.DropDown):
                extra = f"  items={w.get_model().get_n_items()}"
            lines.append("  " * depth + type(w).__name__ + extra)
            child = w.get_first_child()
            while child is not None:
                walk(child, depth + 1)
                child = child.get_next_sibling()

        walk(win)
        print("\n".join(lines))
        print(f"SELFTEST OK {win.get_property('default-width')}x"
              f"{win.get_property('default-height')} "
              f"saved={len(win.cfg['stations'])} player={type(win.player.playbin).__name__}")

        shot = os.environ.get("RADIO_FLAC_GUI_SHOT")
        if not shot:
            a.quit()
            return

        win.present()
        attempts = {"n": 0}

        def take():
            attempts["n"] += 1
            try:
                if not win.get_mapped() or win.get_width() < 50:
                    raise RuntimeError("окно ещё не отрисовано")
                size = win._snapshot(shot)
                rows = 0
                icons = 0
                row = win.results.get_first_child()
                while row is not None:
                    rows += 1
                    box = row.get_child()
                    picture = box.get_first_child() if box is not None else None
                    if isinstance(picture, Gtk.Picture) and picture.get_paintable() is not None:
                        icons += 1
                    row = row.get_next_sibling()
                print(f"SHOT {shot} {size[0]}x{size[1]} строк_в_списке={rows} "
                      f"иконок_загружено={icons}")
            except Exception as e:  # noqa: BLE001
                if attempts["n"] < 10:
                    print(f"  попытка {attempts['n']}: {e} — подожду")
                    GLib.timeout_add(700, take)
                    return False
                print("SHOT FAILED:", e)
            a.quit()
            return False

        GLib.timeout_add(int(os.environ.get("RADIO_FLAC_GUI_SHOT_DELAY", "3500")), take)

    app.connect("activate", on_activate)
    return app.run([])


def playtest():
    """Интеграционная проверка: окно → выбор станции → реальное воспроизведение."""
    app = Adw.Application(application_id=APP_ID + ".PlayTest")

    def on_activate(a):
        win = Window(a)
        win.present()

        def start():
            station = win.station or {"url": "https://ice1.somafm.com/groovesalad-128-mp3",
                                      "name": "SomaFM Groove Salad", "codec": "MP3"}
            win._play_station(station)
            print("PLAYTEST старт:", station["name"])
            GLib.timeout_add_seconds(14, check)
            return False

        def check():
            print("PLAYTEST is_playing:", win.player.is_playing())
            print("PLAYTEST now_title:", win.now_title.get_text())
            print("PLAYTEST иконка кнопки:", win.play_button.get_icon_name())
            print("PLAYTEST громкость:", round(win.player.playbin.get_property("volume"), 2))
            shot = os.environ.get("RADIO_FLAC_GUI_SHOT")
            if shot:
                try:
                    print("PLAYTEST SHOT", win._snapshot(shot))
                except Exception as e:  # noqa: BLE001
                    print("PLAYTEST SHOT FAILED:", e)
            win.player.stop()
            a.quit()
            return False

        GLib.timeout_add(1200, start)

    app.connect("activate", on_activate)
    return app.run([])


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        display = Gdk.Display.get_default()
        if display is not None:
            Gtk.StyleContext.add_provider_for_display(
                display, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = self.props.active_window or Window(self)
        win.present()


def main():
    if not os.path.exists(RECORDER):
        print(f"не найден {RECORDER} — сначала установите radio-flac", file=sys.stderr)
        return 1
    Gst.init(None)
    if os.environ.get("RADIO_FLAC_GUI_SELFTEST"):
        return selftest()
    if os.environ.get("RADIO_FLAC_GUI_PLAYTEST"):
        return playtest()
    return App().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())







