def _find_recorder():
    """Портативная сборка: radio-flac(.exe) лежит рядом с GUI."""
    if getattr(sys, "frozen", False):
        base = os.path.dirname(sys.executable)
        for cand in ("radio-flac.exe", "radio-flac"):
            p = os.path.join(base, cand)
            if os.path.exists(p):
                return p
    return (shutil.which("radio-flac")
            or os.path.expanduser("~/.local/bin/radio-flac"))


