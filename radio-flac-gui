def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_PATH, encoding="utf-8") as f:
            cfg.update(json.load(f))
    except (OSError, ValueError):
        pass
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2)
    os.replace(tmp, CONFIG_PATH)


def codec_hint(codec):
    if "FLAC" in (codec or "").upper():
        return "станция вещает во FLAC — запись будет истинно lossless"
    return "поток lossy: FLAC сохранит размер, но не качество"


def rb_get(path, params=None, timeout=25):
    url = f"{RB_API}/{path}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def normalize(s):
    url = s.get("url_resolved") or s.get("url") or ""
    if not url:
        return None
    return {
        "name": (s.get("name") or "?").strip(),
        "url": url,
        "codec": (s.get("codec") or "?").strip(),
        "bitrate": s.get("bitrate") or 0,
        "country": s.get("country") or "",
        "tags": [t for t in (s.get("tags") or "").split(",") if t][:4],
        "favicon": s.get("favicon") or "",
    }


def rb_stations(name="", countrycode="", tag="", limit=120):
    params = {"limit": limit, "order": "clickcount", "reverse": "true",
              "hidebroken": "true"}
    if name:
        params["name"] = name
    if countrycode:
        params["countrycode"] = countrycode
    if tag:
        params["tagList"] = tag
    data = rb_get("stations/search", params)
    return [n for n in (normalize(s) for s in data) if n]


def rb_popular(limit=120):
    data = rb_get(f"stations/topclick/{limit}")
    return [n for n in (normalize(s) for s in data) if n]


def rb_countries(limit=90):
    data = [c for c in rb_get("countries")
            if c.get("stationcount", 0) > 10 and c.get("iso_3166_1")]
    data.sort(key=lambda c: -c.get("stationcount", 0))
    return [(c["name"], c["iso_3166_1"]) for c in data[:limit]]


def rb_tags(limit=160):
    data = [t for t in rb_get("tags") if t.get("stationcount", 0) > 25]
    data.sort(key=lambda t: -t.get("stationcount", 0))
    return [t["name"] for t in data[:limit]]


class Player:
    """Воспроизведение станции через playbin; отдаёт состояние и название трека."""

    def __init__(self, on_state, on_title):
        self.on_state = on_state
        self.on_title = on_title
        self.playbin = Gst.ElementFactory.make("playbin", "radio")
        self.playbin.set_property("volume", 0.8)
        sink = self._make_sink()
        if sink is not None:
            self.playbin.set_property("audio-sink", sink)
        self.bus = self.playbin.get_bus()
        self.bus.add_watch(GLib.PRIORITY_DEFAULT, self._on_message)

    @staticmethod
    def _make_sink():
        """Явный pulsesink со своим именем: иначе приложение видно в микшере
        как «python3» и наследует его настройки (в т.ч. mute)."""
        if Gst.ElementFactory.find("pulsesink") is None:
            return None
        sink = Gst.ElementFactory.make("pulsesink", "radio_out")
        if sink is None:
            return None
        for prop, value in (("client-name", "Radio FLAC"), ("volume", 1.0), ("mute", False)):
            if sink.find_property(prop) is not None:
                sink.set_property(prop, value)
        return sink

    # --- управление ---
    def play(self, station):
        self.playbin.set_state(Gst.State.NULL)
        self.playbin.set_property("uri", station["url"])
        self.station = station
        self.playbin.set_state(Gst.State.PLAYING)
        # микшер может помнить mute для этого приложения — снимаем его после старта
        GLib.timeout_add(1200, self._unmute)
        GLib.timeout_add(3000, self._unmute)

    def _unmute(self):
        sink = self.playbin.get_property("audio-sink")
        if sink is not None and sink.find_property("mute") is not None:
            try:
                if sink.get_property("mute"):
                    sink.set_property("mute", False)
            except Exception:  # noqa: BLE001
                pass
        return False

    def toggle(self):
        state = self.playbin.get_state(0)[1]
        if state == Gst.State.PLAYING:
            self.playbin.set_state(Gst.State.PAUSED)
        elif state in (Gst.State.PAUSED, Gst.State.READY, Gst.State.NULL):
            if self.station is None:
                return
            if state == Gst.State.PAUSED:
                self.playbin.set_state(Gst.State.PLAYING)
            else:
                self.play(self.station)

    def stop(self):
        self.playbin.set_state(Gst.State.NULL)
        self.station = None

    def is_playing(self):
        return self.playbin.get_state(0)[1] == Gst.State.PLAYING

    def set_volume(self, value):
        self.playbin.set_property("volume", max(0.0, min(1.0, value)))

    # --- сообщения шины ---
    def _on_message(self, _bus, msg):
        kind = msg.type
        if kind == Gst.MessageType.ERROR:
            err, _debug = msg.parse_error()
            self.playbin.set_state(Gst.State.NULL)
            GLib.idle_add(self.on_state, "error", err.message)
        elif kind == Gst.MessageType.EOS:
            GLib.idle_add(self.on_state, "eos", "")
        elif kind == Gst.MessageType.TAG:
            tags = msg.parse_tag()
            for key in ("title", "artist"):
                ok, value = tags.get_string(key)
                if ok and key == "title":
                    GLib.idle_add(self.on_title, value)
        elif kind == Gst.MessageType.STATE_CHANGED and msg.src == self.playbin:
            _old, new, _pending = msg.parse_state_changed()
            GLib.idle_add(self.on_state, new.value_nick, "")
        return True


class Equalizer:
    """10-полосный эквалайзер как audio-filter внутри playbin."""

    def __init__(self, player, cfg):
        self.element = Gst.ElementFactory.make("equalizer-10bands", "equalizer")
        player.playbin.set_property("audio-filter", self.element)
        self.gains = list(cfg.get("eq_gains") or [0] * 10)
        self.enabled = bool(cfg.get("eq_enabled"))
        self.audio_bus = []

    def apply(self, gains=None, enabled=None):
        if gains is not None:
            self.gains = [float(g) for g in gains][:10]
        if enabled is not None:
            self.enabled = bool(enabled)
        for index in range(10):
            value = self.gains[index] if self.enabled else 0.0
            self.element.set_property(f"band{index}", float(value))

    def set_band(self, index, value):
        self.gains[index] = float(value)
        if self.enabled:
            self.element.set_property(f"band{index}", float(value))


class Recorder:
    """Обёртка над radio-flac: запуск, поток лога, остановка по SIGTERM."""

    def __init__(self, on_line, on_exit):
        self.proc = None
        self.on_line = on_line
        self.on_exit = on_exit
        self.started = 0.0

    @property
    def running(self):
        return self.proc is not None and self.proc.poll() is None

    def start(self, url, name, directory, min_duration, split_every=0, full_tracks=False,
              lead=0.0):
        if self.running:
            return False
        os.makedirs(directory, exist_ok=True)
        cmd = [RECORDER, url, "-d", directory, "-n", name,
               "--min-duration", str(min_duration)]
        if split_every:
            cmd += ["--split-every", str(split_every)]
        if full_tracks:
            cmd.append("--full-tracks")
        if lead:
            cmd += ["--lead", str(lead)]
        try:
            self.proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1, start_new_session=True)
        except OSError as e:
            self.on_line(f"не удалось запустить {RECORDER}: {e}")
            return False
        self.started = time.time()
        threading.Thread(target=self._pump, daemon=True).start()
        return True

    def _pump(self):
        proc = self.proc
        for line in proc.stdout:
            GLib.idle_add(self.on_line, line.rstrip())
        code = proc.wait()
        self.proc = None
        GLib.idle_add(self.on_exit, code)

    def stop(self):
        if self.running:
            try:
                os.killpg(os.getpgid(self.proc.pid), signal.SIGTERM)
            except OSError:
                self.proc.terminate()
        return True


def make_row(station, on_play, on_favorite=None, favorite=False, on_delete=None):
    """Строка станции: иконка, название, избранное, удаление, кнопка «слушать»."""
    row = Gtk.ListBoxRow()
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10,
                  margin_top=6, margin_bottom=6, margin_start=10, margin_end=8)
    box.append(rf_icons.StationIcon(station.get("favicon", "")))
    text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
    title = Gtk.Label(label=station["name"], xalign=0, ellipsize=Pango.EllipsizeMode.END)
    bits = [station["codec"]]
    if station.get("bitrate"):
        bits.append(f"{station['bitrate']} kbps")
    if station.get("country"):
        bits.append(station["country"])
    if "FLAC" in station["codec"].upper():
        bits.append("lossless")
    subtitle = Gtk.Label(label=" · ".join(bits), xalign=0,
                         css_classes=["dim-label", "caption"],
                         ellipsize=Pango.EllipsizeMode.END)
    text.append(title)
    text.append(subtitle)
    box.append(text)
    if on_favorite is not None:
        heart = Gtk.ToggleButton(icon_name="emblem-favorite-symbolic", active=bool(favorite),
                                 css_classes=["flat", "circular"], valign=Gtk.Align.CENTER,
                                 tooltip_text="Убрать из моих станций" if favorite
                                 else "Добавить в мои станции")
        if favorite:
            heart.add_css_class("accent")

        def on_toggled(button, station=station, heart=heart):
            active = button.get_active()
            button.set_tooltip_text("Убрать из моих станций" if active
                                    else "Добавить в мои станции")
            if active:
                heart.add_css_class("accent")
            else:
                heart.remove_css_class("accent")
            on_favorite(station, active)

        heart.connect("toggled", on_toggled)
        row.heart = heart
        box.append(heart)
    if on_delete is not None:
        trash = Gtk.Button(icon_name="user-trash-symbolic", css_classes=["flat", "circular"],
                           valign=Gtk.Align.CENTER, tooltip_text="Удалить из моих станций")
        trash.connect("clicked", lambda *_: on_delete(station))
        box.append(trash)
    play = Gtk.Button(icon_name="media-playback-start-symbolic", css_classes=["flat", "circular"],
                      tooltip_text="Слушать", valign=Gtk.Align.CENTER)
    play.connect("clicked", lambda *_: on_play(station))
    box.append(play)
    row.set_child(box)
    row.station = station
    return row


